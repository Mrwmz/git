# ----------------------------
# 操作系统生成的文件
# ----------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/
[Dd]esktop.ini
# 安装包/压缩包（按需保留可删除此行）
*.exe
*.msi

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
.com.apple.timemachine.donotpresent

# Linux
*~
.fuse_hidden*
.directory
.Trash-*
.nfs*

# ----------------------------
# 编辑器 / IDE 私有配置
# ----------------------------
# Visual Studio Code（默认忽略，但保留可团队共享的配置）
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# JetBrains 系列 (IDEA / PyCharm / WebStorm 等)
.idea/
*.iml
*.ipr
*.iws

# Eclipse / STS
.project
.classpath
.settings/
.factorypath

# Vim / Emacs / Sublime
*.swp
*.swo
*.sublime-workspace
*.sublime-project
*#
.#*

# Claude Code 本地权限配置（团队共享配置不要忽略）
.claude/settings.local.json

# ----------------------------
# 日志、临时文件、缓存
# ----------------------------
*.log
logs/
*.tmp
*.temp
*.bak
*.cache
tmp/
temp/
*.pid
*.seed

# ----------------------------
# 环境变量与密钥（切勿提交）
# ----------------------------
.env
.env.local
.env.*.local
*.pem
*.key
secrets.*
